# 把這個檔案複製成 .env，再填入自己的值。
# .env 裡是你的私人設定，不要上傳到 GitHub（.gitignore 已經排除它）。

# YouTube Data API v3 金鑰（必填，「多久沒開台」功能會用到）
# 申請方式請看 README 的「第 1 步」
YOUTUBE_API_KEY=

# 允許呼叫這個後端的前端網址（必填），多個網址用逗號分隔，結尾不要加斜線
# 本機開發填 http://localhost:5173
# 上線後改成你的前端網址，例如 https://你的專案名稱.pages.dev
ALLOWED_ORIGINS=http://localhost:5173

# 後端使用的連接埠（選填）。本機預設 8080；部署到 Render 時不用設定，平台會自動提供
PORT=8080

# ---- 以下是選用功能：Twitch 查詢（不需要就留空）----
# Twitch 應用程式的 Client ID 與 Client Secret，申請方式請看 README 的「加碼：啟用 Twitch 查詢」
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
