{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liveinfo-oshi-tw",
  "main": "src/worker/index.ts",
  // The newest date the bundled workerd (1.20261119) knows, so local tests run
  // with the same runtime behaviour as production.
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "liveinfo.oshi.tw", "custom_domain": true }],

  // The Vue app is served as static assets; any path that is not a file falls
  // back to index.html. /api/* reaches the Worker, and so do the result pages:
  // served by the asset handler, /last/@NASA would first redirect to /last/%40NASA.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/last/*", "/recent/*"]
  },

  // Handle → channel and Twitch token cache. No id on purpose: the first
  // `wrangler deploy` provisions the namespace and later deploys keep using it.
  "kv_namespaces": [{ "binding": "CACHE" }],

  // One LookupCoordinator per lookup ("youtube:last:@nasa"): it holds the
  // answer and makes visitors asking at the same time share one API lookup.
  "durable_objects": {
    "bindings": [{ "name": "LOOKUPS", "class_name": "LookupCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LookupCoordinator"] }],

  // Per-IP limit on /api/last and /api/recent.
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1122000801",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  "vars": {
    // Sent as the Referer header to the YouTube Data API, so an API key with an
    // HTTP-referrer restriction for this site keeps working from the Worker.
    "YOUTUBE_API_REFERER": "https://liveinfo.oshi.tw/"
  },

  // TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET are optional secrets: Twitch lookup
  // is enabled only when both are set.
  "secrets": { "required": ["YOUTUBE_API_KEY"] },

  "observability": { "enabled": true }
}
