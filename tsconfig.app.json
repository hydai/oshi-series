{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.vue",
    "src/shared/**/*.ts",
    "test/client/**/*.ts"
  ]
}
