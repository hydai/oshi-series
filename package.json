{
  "name": "liveinfo-oshi-tw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "你推多久沒開台了？／你推最近開了多久？ — a single Cloudflare Worker serving liveinfo.oshi.tw",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "vite",
    "predev:worker": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\"",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "pretest": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\"",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.client.config.ts",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:client": "vitest run --config vitest.client.config.ts",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint .",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  }
}
