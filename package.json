{
  "name": "liveinfo-oshi-tw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "你推多久沒開台了？／你推最近開了多久？ — a single Cloudflare Worker serving liveinfo.oshi.tw",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "wrangler types",
    "predev:worker": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\"",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "pretest": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\"",
    "test": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
